# ─────────────────────────────────────────────────────────
# TypeDuel — Environment Variables
# Copy this file to .env and fill in the values.
# The server will refuse to start if required vars are missing.
# ─────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Client ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# ── Database ────────────────────────────────────────────
# Relative to server/src (will be resolved at runtime)
DATABASE_PATH=../data/typeduel.db

# ── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_64_BYTE_HEX_SECRET_FOR_ACCESS_TOKENS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_64_BYTE_HEX_SECRET_FOR_REFRESH_TOKENS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookies ─────────────────────────────────────────────
# Must be https in production; set to false for local http dev only
COOKIE_SECURE=false

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Security ────────────────────────────────────────────
BCRYPT_ROUNDS=2
# Toggle Cloudflare Turnstile CAPTCHA (set to true in production)
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=

# ── Contact Form ────────────────────────────────────────
# Optional: configure SMTP to actually send contact emails
CONTACT_EMAIL=hello@typeduel.io

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info

# ── App ─────────────────────────────────────────────────
APP_URL=http://localhost:3001
